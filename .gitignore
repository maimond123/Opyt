# Credentials — never commit
.env

# Extra
opyt-worktrees/

# Claude Code per-machine state. Named individually rather than a blanket `.claude/`: a
# blanket rule would silently swallow a SHARED `.claude/settings.json`, `commands/` or
# `skills/` added later, which is the same defect the docs/* allowlist had (6150196c).
# `settings.local.json` is Claude Code's own name for the never-shared half.
.claude/settings.local.json
.claude/RESUME.md
.claude/scheduled_tasks.lock
.claude/worktrees/

# Playwright MCP scratch — console logs and page snapshots it drops beside the checkout when a
# session drives a browser. Per-machine debris from one tool run, never source. Ignored for the
# same reason as the generated website files below: untracked AND unignored is the bad third
# state, and this worktree is shared by concurrent sessions where one `git add` would commit it.
.playwright-mcp/

# Python
venv/
__pycache__/
*.pyc
*.pyo
.Python

# Personal config — the author's REAL config lives here in the working tree but is
# untracked, so it never ships in the wheel/sdist or the public snapshot. Only the
# sanitized config/*.example.* templates are tracked. (See opyt_core/config.py.)
config/settings.yaml
config/taxonomy.json


# Runtime dedup/cache state — per-machine, regenerated on demand; some files embed
# absolute vault paths and discovered-people data. Never tracked.
state/*.json

# macOS
.DS_Store

# Python packaging build artifacts (from `pip install -e .`)
*.egg-info/
build/
dist/

# generated by website/build_compare.py — edit website/compare_data.py instead
website/compare.html
website/vs/

# generated by website/build_sitemap.py, which deploy.sh runs. Same rule as the two above:
# build output, not source. Untracked AND unignored is the bad third state — it puts them in
# every `git status` and one `git add` away from being committed as if they were hand-written.
website/sitemap.xml
website/robots.txt

# uv.lock — a local resolve artifact with no consumer here. scripts/setup.sh builds with
# `python3 -m venv` + `pip install -e`, the published package resolves from pyproject.toml's
# constraints, and nothing in the repo or CI passes --locked or --frozen. Tracking a 640 KB
# file that nothing reads is churn. If a build ever pins from it, track it in that change.
uv.lock

# Built by website/deploy.sh from website/opyt-install.command on every deploy.
# The .command is the source of truth and is tracked; this is just its shipping wrapper.
website/opyt-install.command.zip

# Scratch scripts and pre-announce marketing drafts — never part of the tree, and one
# careless `git add -A` away from a public `--refresh` shipping them.
scratch_*.py
marketing/
