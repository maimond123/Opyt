{
  "manifest_version": "0.2",
  "name": "opyt",
  "display_name": "Opyt",
  "version": "__OPYT_VERSION__",
  "description": "A knowledge base that grows from your attention across the platforms you already use, served to your AI client over MCP.",
  "author": {
    "name": "David Maimon"
  },
  "homepage": "https://github.com/maimond123/Opyt",
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "mcp",
    "knowledge-base",
    "rag",
    "research"
  ],
  "server": {
    "type": "binary",
    "entry_point": "bin/launch.sh",
    "mcp_config": {
      "command": "/bin/sh",
      "args": [
        "${__dirname}/bin/launch.sh"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "darwin"
    ]
  }
}
