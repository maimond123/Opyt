# OPYT credentials — copy to .env (or $OPYT_HOME/.env) and fill in.
# scripts/setup.sh copies this to .env on first run. Never commit the real .env.

# ── Optional: embeddings and chart reading ────────────────────────────────────────
# Without it Opyt calls no model: search matches words and images are not read. Users are never
# asked for it; it is a developer switch (docs/plans/2026-10-12-free-only-no-own-key.md).
OPENROUTER_API_KEY=        # https://openrouter.ai/keys


# ── Optional: GitHub (raises the ingester past 60 req/hr to 5000) ───────────────
GITHUB_TOKEN=              # https://github.com/settings/tokens

# ── X: NO key needed, and no way to supply one ──────────────────────────────────
# EVERY X read — your bookmarks, an Oracle's timeline, a single post, a profile — runs on your
# own logged-in x.com session through x.com's internal GraphQL API. Just log into x.com in a
# local browser. No X Developer account, no OAuth, no token, no third party.
# `TWITTERAPI_KEY` lived here until 2026-08-30 and is now unused; delete it from your .env.

# ── Optional: Semantic Scholar (paper ingest) ───────────────────────────────────
# Unauthenticated is ~1 req/sec SHARED across every anonymous caller, so paper ingest gets
# 429'd and skips papers until a later run. A key raises that to your own quota.
S2_API_KEY=                # https://www.semanticscholar.org/product/api#api-key-form

# ── Set for you, not by hand: publishing a knowledge base ───────────────────────
# The `share` tool registers this install and writes this token itself. Set it manually only for
# the operator procedure in service/DEPLOY.md, against a token minted on the box.
# A READER needs nothing here: their reader token goes into the peers registry, not into .env.
OPYT_SERVICE_TOKEN=
