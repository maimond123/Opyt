# OPYT credentials — copy to .env (or $OPYT_HOME/.env) and fill in.
# scripts/setup.sh copies this to .env on first run. Never commit the real .env.

# ── Required: the LLM pipeline (classify / extract / taxonomy / vision) ──────────
# Runs through OpenRouter by default (see config/settings.yaml llm_backends.roles).
OPENROUTER_API_KEY=        # https://openrouter.ai/keys


# ── Optional: GitHub (raises the ingester past 60 req/hr to 5000) ───────────────
GITHUB_TOKEN=              # https://github.com/settings/tokens

# ── X: NO key needed, and no way to supply one ──────────────────────────────────
# EVERY X read — your bookmarks, an Oracle's timeline, a single post, a profile — runs on your
# own logged-in x.com session through x.com's internal GraphQL API. Just log into x.com in a
# local browser. No X Developer account, no OAuth, no token, no third party.
# `TWITTERAPI_KEY` lived here until 2026-08-30 and is now unused; delete it from your .env.
